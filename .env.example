APP_NAME=Local LLM Handover
APP_ENV=development
DATABASE_PATH=data/handover.db
DOCUMENT_STORE_PATH=data/documents
MAX_UPLOAD_BYTES=52428800
PAGE_STORE_PATH=data/pages
OCR_DPI=150
OCR_MAX_PIXELS=25000000
OCR_LANGUAGE=korean
# Offline model directories (optional)
OCR_DETECTION_MODEL_DIR=
OCR_RECOGNITION_MODEL_DIR=
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_ENDPOINT=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60
VECTOR_STORE=chroma
VECTOR_STORE_PATH=data/chroma
EMBEDDING_MODEL_PATH=data/models/multilingual-e5-small
